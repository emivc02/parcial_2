<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial2.controller.SolicitudesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets bottom="14" left="20" right="20" top="14" />
            </padding>
            <Label text="Solicitudes de servicio">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVolver" onAction="#volverInicio" text="Volver al inicio" />
        </HBox>
    </top>
    <center>
        <HBox spacing="16">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
            <VBox minWidth="510" prefWidth="510" spacing="10">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <VBox spacing="8">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>
                        <Label text="Nueva solicitud">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="Código" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label text="Cliente" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="Cliente registrado" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label text="Atención" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <CheckBox fx:id="chkPresencial" onAction="#cambiarPresencial" text="Requiere atención presencial" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label text="Especialidad" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <ComboBox fx:id="cmbEspecialidad" maxWidth="Infinity" promptText="Solo si es presencial" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <Label text="Fecha programada" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <DatePicker fx:id="dpFechaProgramada" maxWidth="Infinity" promptText="Opcional" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            <Label text="Prioridad" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <ComboBox fx:id="cmbPrioridad" maxWidth="Infinity" promptText="Opcional" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            <Label text="Observaciones" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.valignment="TOP" />
                            <TextArea fx:id="txtObservaciones" prefRowCount="2" promptText="Opcional" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        </GridPane>
                        <Label text="Elementos disponibles">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <padding>
                                <Insets top="8" />
                            </padding>
                        </Label>
                        <ListView fx:id="listaDisponibles" prefHeight="104" />
                        <HBox spacing="8">
                            <Button fx:id="btnAgregar" onAction="#agregarElementos" text="Agregar seleccionados" />
                            <Button fx:id="btnQuitar" onAction="#quitarElementos" text="Quitar seleccionados" />
                        </HBox>
                        <Label text="Elementos contratados">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ListView fx:id="listaContratados" prefHeight="104" />
                    </VBox>
                </ScrollPane>
                <VBox spacing="8">
                    <Label fx:id="lblSubtotal" text="Subtotal">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <HBox spacing="8">
                        <Button fx:id="btnRegistrar" onAction="#registrarSolicitud" text="Registrar solicitud" />
                        <Button fx:id="btnLimpiar" onAction="#limpiarFormulario" text="Limpiar formulario" />
                    </HBox>
                </VBox>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Solicitudes registradas">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaSolicitudes" minHeight="150" prefHeight="210">
                    <columns>
                        <TableColumn fx:id="colCodigo" minWidth="70" text="Código" />
                        <TableColumn fx:id="colCliente" minWidth="150" prefWidth="170" text="Cliente" />
                        <TableColumn fx:id="colElementos" minWidth="70" text="Elementos" />
                        <TableColumn fx:id="colEstado" minWidth="80" text="Estado" />
                        <TableColumn fx:id="colCosto" minWidth="90" text="Costo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Label text="Detalle de la solicitud">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextArea fx:id="txtDetalle" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
